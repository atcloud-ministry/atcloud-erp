{
	// Local dev setup. "Dev: Start everything" runs automatically when this
	// folder opens (after you allow automatic tasks once). The old task list is
	// saved in tasks.json.bak.
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Dev: Start everything",
			"dependsOn": ["Dev: Open preview"],
			"runOptions": { "runOn": "folderOpen" },
			"problemMatcher": []
		},
		{
			"label": "Dev: MongoDB",
			"type": "shell",
			"command": "& \"${workspaceFolder}\\.vscode\\start-mongo.ps1\"",
			"options": {
				"shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"] }
			},
			"isBackground": true,
			"problemMatcher": {
				"owner": "mongod",
				"pattern": { "regexp": "^__never__$" },
				"background": {
					"activesBegin": true,
					"beginsPattern": ".",
					"endsPattern": "(Waiting for connections|already running)"
				}
			},
			"presentation": { "reveal": "silent", "panel": "dedicated", "group": "dev" }
		},
		{
			"label": "Dev: Backend",
			"type": "shell",
			"command": "$env:NODE_ENV='development'; npx nodemon src/index.ts",
			"options": {
				"cwd": "${workspaceFolder}/backend",
				"shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
			},
			"dependsOn": ["Dev: MongoDB"],
			"isBackground": true,
			"problemMatcher": {
				"owner": "nodemon",
				"pattern": { "regexp": "^__never__$" },
				"background": {
					"activesBegin": true,
					"beginsPattern": "\\[nodemon\\]",
					"endsPattern": "(running on port|listening|Server running|EADDRINUSE)"
				}
			},
			"presentation": { "reveal": "silent", "panel": "dedicated", "group": "dev" }
		},
		{
			"label": "Dev: Frontend",
			"type": "shell",
			"command": "npx vite --port 5173 --strictPort",
			"options": {
				"cwd": "${workspaceFolder}/frontend",
				"shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
			},
			"dependsOn": ["Dev: Backend"],
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"pattern": { "regexp": "^__never__$" },
				"background": {
					"activesBegin": true,
					"beginsPattern": "VITE|vite",
					"endsPattern": "(Local:|already in use)"
				}
			},
			"presentation": { "reveal": "silent", "panel": "dedicated", "group": "dev" }
		},
		{
			"label": "Dev: Open preview",
			"type": "shell",
			"command": "echo Preview opened at http://localhost:5173 ${input:openPreview}",
			"dependsOn": ["Dev: Frontend"],
			"problemMatcher": [],
			"presentation": { "reveal": "never", "close": true }
		},
		{
			"label": "Dev: Frontend tests",
			"type": "shell",
			"command": "$env:NODE_OPTIONS='--max-old-space-size=4096'; npx vitest run",
			"options": {
				"cwd": "${workspaceFolder}/frontend",
				"shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
			},
			"group": "test",
			"problemMatcher": []
		},
		{
			"label": "Start Stripe CLI Webhook Forwarding",
			"type": "shell",
			"command": "stripe",
			"args": ["listen", "--forward-to", "localhost:5001/api/webhooks/stripe"],
			"isBackground": true,
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			// Opens the site in VS Code's built-in browser tab.
			"id": "openPreview",
			"type": "command",
			"command": "simpleBrowser.api.open",
			"args": "http://localhost:5173/#/login"
		}
	]
}
