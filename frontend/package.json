{
  "name": "frontend",
  "private": true,
  "version": "2.53.1",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-pwa-build.mjs && cp dist/index.html dist/404.html && cp static.json dist/static.json && cp public/_redirects dist/_redirects",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "verify": "npm run lint && npm run type-check",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:watch": "NODE_OPTIONS=--max-old-space-size=4096 vitest --watch",
    "test:verbose": "VITEST_VERBOSE_LOGS=true NODE_OPTIONS=--max-old-space-size=4096 vitest run --reporter=verbose",
    "pretest:e2e": "npm --prefix .. run build --workspace=@atcloud/shared-time",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "playwright test --config=playwright.pwa.config.ts",
    "test:e2e:fullstack:playwright": "playwright test --config=playwright.fullstack.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc -b --pretty false",
    "clean-install": "rm -rf node_modules && npm install",
    "pre-deploy": "npm run clean-install && npm run verify && npm run build && npm test",
    "check-deps": "npm ls --depth=0"
  },
  "dependencies": {
    "@atcloud/shared-time": "file:../shared",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.1.1",
    "@stripe/stripe-js": "^8.0.0",
    "date-fns": "^2.30.0",
    "html2pdf.js": "0.14.0",
    "libphonenumber-js": "1.13.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "react-router-dom": "7.18.4",
    "recharts": "^3.4.1",
    "socket.io-client": "^4.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/html2pdf.js": "^0.10.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.6",
    "@vitest/ui": "3.2.6",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.9.1",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "jsdom": "^23.0.0",
    "postcss": "8.5.28",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.34.1",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
